{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/skills/gantry/scripts/guard.py\" PreToolUse --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" --format claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/skills/gantry/scripts/guard.py\" PostToolUse --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" --format claude-code"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/skills/gantry/scripts/guard.py\" SubagentStart --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" --format claude-code"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/skills/gantry/scripts/guard.py\" SubagentStop --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" --format claude-code"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/skills/gantry/scripts/guard.py\" PreCompact --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" --format claude-code"
          }
        ]
      }
    ]
  }
}
