# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test and coverage output
coverage/
.nyc_output/
*.lcov

# Caches
__pycache__/
.pytest_cache/
.cache/
.eslintcache
.vitest/
.turbo/
.parcel-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/fixtures/**/*.key

# Gantry runtime state
# The machine factory lives at ~/.gantry, but a stray local one must never be committed.
.gantry/
# The reference fixture's own tracked repository policy is reusable fixture content,
# not runtime state, and must be committed.
!fixture/.gantry/
!fixture/.gantry/**
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini

.claude/worktrees/

# Notes
# This file deliberately does NOT ignore `**/[Bb]in/*`. The previous Visual Studio / .NET
# template did, which silently ignored `src/bin/gantry.ts` — the package's binary entry
# point. See `.scratch/release-engineering/issues/01-repository-bootstrap.md`.
