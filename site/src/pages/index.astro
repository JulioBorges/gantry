---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import { PipelineSimulator } from '../components/PipelineSimulator';
---

<BaseLayout
  title="Gantry // Harness-Neutral Agentic SDLC"
  description="Deterministic agentic SDLC skill pack. Turning living specs into verified software deliveries inside your coding harness."
>
  <div class="space-y-16 py-4">
    <!-- Hero Section with Crane Motif and Multi-Harness Install Widget -->
    <HeroSection />

    <!-- Interactive Pipeline Simulator Island -->
    <section id="pipeline" class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-obsidian-700/80 pb-3">
        <div>
          <div class="text-xs font-mono text-amber-accent flex items-center space-x-2">
            <span class="w-2 h-2 bg-amber-glow"></span>
            <span class="uppercase tracking-widest">INTERACTIVE DEMO // SDLC PHASES</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-extrabold text-slate-100 uppercase font-mono mt-1">
            Pipeline Simulator
          </h2>
        </div>
        <p class="text-xs text-slate-400 font-mono max-w-md">
          Explore the 6 deterministic execution phases from Spec verification to serial gate integration.
        </p>
      </div>

      <!-- Simulator Client Island -->
      <PipelineSimulator client:load />
    </section>

    <!-- Skills Pack Anchor Section -->
    <section id="skills" class="border border-obsidian-700 bg-obsidian-850/50 p-6 sm:p-8">
      <div class="flex items-center justify-between border-b border-obsidian-700 pb-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-100 uppercase tracking-wide font-mono">
            The Three Skills
          </h2>
          <p class="text-xs text-slate-400 mt-1 font-mono">Modular agent skills for repository lifecycle</p>
        </div>
        <span class="text-xs px-2.5 py-1 bg-obsidian-800 text-amber-accent border border-obsidian-700 font-mono">
          PACK RIG
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono">
        <div class="p-5 bg-obsidian-900 border border-obsidian-700 hover:border-amber-glow/50 transition-colors">
          <div class="text-amber-glow font-bold text-sm flex items-center space-x-2">
            <span>◆</span>
            <span>gantry</span>
          </div>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            The core workflow skill executing planning, implementation, review, and critic loops deterministically.
          </p>
        </div>
        <div class="p-5 bg-obsidian-900 border border-obsidian-700 hover:border-amber-glow/50 transition-colors">
          <div class="text-amber-glow font-bold text-sm flex items-center space-x-2">
            <span>◆</span>
            <span>gantry-setup</span>
          </div>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Conversational repository onboarding, capability detection, and .gantry/config.json policy configuration.
          </p>
        </div>
        <div class="p-5 bg-obsidian-900 border border-obsidian-700 hover:border-amber-glow/50 transition-colors">
          <div class="text-amber-glow font-bold text-sm flex items-center space-x-2">
            <span>◆</span>
            <span>gantry-dashboard</span>
          </div>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Loopback-only, read-only multi-run kanban observer tracking phases, worktrees, and inflight runs.
          </p>
        </div>
      </div>
    </section>

    <!-- Harness Matrix Anchor Section -->
    <section id="matrix" class="border border-obsidian-700 bg-obsidian-850/50 p-6 sm:p-8">
      <div class="flex items-center justify-between border-b border-obsidian-700 pb-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-100 uppercase tracking-wide font-mono">
            Harness Compatibility
          </h2>
          <p class="text-xs text-slate-400 mt-1 font-mono">Honest support tiers across agent execution environments</p>
        </div>
        <span class="text-xs px-2.5 py-1 bg-obsidian-800 text-amber-accent border border-obsidian-700 font-mono">
          TIER MATRIX
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-obsidian-900 text-slate-400 border-b border-obsidian-700">
            <tr>
              <th class="p-3">Harness</th>
              <th class="p-3">Tier</th>
              <th class="p-3">Hooks Support</th>
              <th class="p-3">Role Execution</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-obsidian-700">
            <tr class="bg-obsidian-900/40">
              <td class="p-3 text-slate-200 font-bold">Claude Code</td>
              <td class="p-3 text-amber-glow font-bold">Reference</td>
              <td class="p-3 text-slate-300">Native Settings + Hooks</td>
              <td class="p-3 text-slate-300">Full Multi-Role</td>
            </tr>
            <tr class="bg-obsidian-900/40">
              <td class="p-3 text-slate-200 font-bold">Antigravity</td>
              <td class="p-3 text-amber-glow font-bold">Supported</td>
              <td class="p-3 text-slate-300">.agents/hooks.json Guard</td>
              <td class="p-3 text-slate-300">Subagents & agy --print</td>
            </tr>
            <tr class="bg-obsidian-900/40">
              <td class="p-3 text-slate-200 font-bold">Codex CLI</td>
              <td class="p-3 text-amber-accent font-bold">Supported</td>
              <td class="p-3 text-slate-300">Direct Process Runner</td>
              <td class="p-3 text-slate-300">Independent Critic / Roles</td>
            </tr>
            <tr class="bg-obsidian-900/40">
              <td class="p-3 text-slate-200 font-bold">OpenCode</td>
              <td class="p-3 text-slate-400 font-bold">Compatible</td>
              <td class="p-3 text-slate-300">Plugin Hooks Wiring</td>
              <td class="p-3 text-slate-300">Per-role subagents</td>
            </tr>
            <tr class="bg-obsidian-900/40">
              <td class="p-3 text-slate-200 font-bold">Cursor</td>
              <td class="p-3 text-slate-400 font-bold">Compatible</td>
              <td class="p-3 text-slate-300">Rules & Commands</td>
              <td class="p-3 text-slate-300">Composer Workflows</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
