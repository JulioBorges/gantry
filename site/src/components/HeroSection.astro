---
import { InstallWidget } from './InstallWidget';
import { translations } from '../i18n/translations';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = translations.en;
---

<section
  data-testid="hero-section"
  class="relative border border-obsidian-700 bg-obsidian-850/90 p-6 sm:p-10 lg:p-12 overflow-hidden shadow-2xl"
>
  <!-- Industrial backdrop aura and technical grid accent -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-glow/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-amber-accent/5 blur-3xl pointer-events-none"></div>

  <!-- Telemetry Header Strip -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-obsidian-700/80 pb-4 mb-8 text-xs font-mono">
    <div class="flex items-center space-x-2 text-amber-accent">
      <span class="inline-block w-2.5 h-2.5 bg-amber-glow animate-pulse"></span>
      <span class="tracking-widest uppercase font-bold" data-i18n="hero.systemStrip">{t.hero.systemStrip}</span>
    </div>

    <!-- Status Badges -->
    <div class="flex flex-wrap items-center gap-2" data-testid="status-badges">
      <span class="px-2 py-0.5 bg-obsidian-900 border border-obsidian-700 text-amber-glow font-bold" data-i18n="hero.badgeStatus">{t.hero.badgeStatus}</span>
      <span class="px-2 py-0.5 bg-obsidian-900 border border-obsidian-700 text-slate-300" data-i18n="hero.badgeHarness">{t.hero.badgeHarness}</span>
      <span class="px-2 py-0.5 bg-obsidian-900 border border-obsidian-700 text-slate-400" data-i18n="hero.badgeLicense">{t.hero.badgeLicense}</span>
      <span class="px-2 py-0.5 bg-obsidian-900 border border-amber-accent/40 text-amber-accent" data-i18n="hero.badgeAiSlop">{t.hero.badgeAiSlop}</span>
    </div>
  </div>

  <!-- Hero Grid: Left Content / Value Prop, Right Crane Visual Rig -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left Column: Copy & Value Proposition & Install Widget -->
    <div class="lg:col-span-7 space-y-6">
      <div class="space-y-3">
        <div class="inline-block text-xs font-mono tracking-widest text-amber-glow font-bold uppercase bg-amber-glow/10 border border-amber-glow/30 px-2.5 py-1" data-i18n="hero.kicker">{t.hero.kicker}</div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-100 uppercase font-mono leading-none">
          <span data-i18n="hero.titleHarness">{t.hero.titleHarness}</span> <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-glow via-amber-accent to-yellow-500" data-i18n="hero.titleAgentic">{t.hero.titleAgentic}</span>
        </h1>

        <!-- Primary Tagline -->
        <p
          data-testid="hero-tagline"
          data-i18n="hero.tagline"
          class="text-base sm:text-lg font-mono font-semibold text-amber-accent leading-snug"
        >{t.hero.tagline}</p>
      </div>

      <!-- Value Proposition -->
      <p
        data-testid="hero-value-prop"
        data-i18n="hero.valueProp"
        class="text-sm sm:text-base text-slate-300 font-mono leading-relaxed max-w-2xl"
      >{t.hero.valueProp}</p>

      <!-- Multi-Harness Quick Install Widget Island -->
      <div class="pt-2">
        <InstallWidget client:load />
      </div>
    </div>

    <!-- Right Column: Official Crane Visual Rig -->
    <div class="lg:col-span-5 flex flex-col items-center">
      <div
        data-testid="crane-visual-rig"
        class="relative w-full max-w-md border-2 border-obsidian-700 bg-obsidian-950 p-2 shadow-2xl group"
      >
        <!-- Corner Technical Brackets -->
        <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-amber-glow"></div>
        <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-amber-glow"></div>
        <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-amber-glow"></div>
        <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-amber-glow"></div>

        <!-- Crane Image Frame -->
        <div class="relative overflow-hidden bg-obsidian-900 border border-obsidian-800">
          <img
            src={`${baseUrl}/gantry.png`}
            alt="Official Gantry Crane Visual Motif - Industrial precision rig lifting an approved Spec into verified software"
            class="w-full h-auto object-cover filter contrast-105 brightness-95 group-hover:scale-102 transition-transform duration-500"
            loading="eager"
          />
          <!-- Scanning telemetry line -->
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-amber-glow/10 to-transparent pointer-events-none animate-pulse"></div>
        </div>

        <!-- Technical Telemetry Footer for Rig -->
        <div class="mt-2 pt-2 border-t border-obsidian-800 flex items-center justify-between text-[10px] font-mono text-slate-400 px-1">
          <div class="flex items-center space-x-1.5">
            <span class="w-1.5 h-1.5 bg-amber-glow"></span>
            <span class="text-slate-300 font-bold uppercase" data-i18n="hero.craneTitle">{t.hero.craneTitle}</span>
          </div>
          <span class="text-amber-accent" data-i18n="hero.craneLoad">{t.hero.craneLoad}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Technical Grid Highlights -->
  <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-obsidian-700/80 pt-6">
    <div class="p-3 bg-obsidian-900/70 border border-obsidian-700">
      <div class="text-[11px] text-slate-400 uppercase font-mono" data-i18n="hero.metricArchLabel">{t.hero.metricArchLabel}</div>
      <div class="text-sm font-bold text-amber-glow mt-1 font-mono" data-i18n="hero.metricArchVal">{t.hero.metricArchVal}</div>
    </div>
    <div class="p-3 bg-obsidian-900/70 border border-obsidian-700">
      <div class="text-[11px] text-slate-400 uppercase font-mono" data-i18n="hero.metricVerifLabel">{t.hero.metricVerifLabel}</div>
      <div class="text-sm font-bold text-slate-200 mt-1 font-mono" data-i18n="hero.metricVerifVal">{t.hero.metricVerifVal}</div>
    </div>
    <div class="p-3 bg-obsidian-900/70 border border-obsidian-700">
      <div class="text-[11px] text-slate-400 uppercase font-mono" data-i18n="hero.metricGatesLabel">{t.hero.metricGatesLabel}</div>
      <div class="text-sm font-bold text-slate-200 mt-1 font-mono" data-i18n="hero.metricGatesVal">{t.hero.metricGatesVal}</div>
    </div>
    <div class="p-3 bg-obsidian-900/70 border border-obsidian-700">
      <div class="text-[11px] text-slate-400 uppercase font-mono" data-i18n="hero.metricOperatorLabel">{t.hero.metricOperatorLabel}</div>
      <div class="text-sm font-bold text-amber-accent mt-1 font-mono" data-i18n="hero.metricOperatorVal">{t.hero.metricOperatorVal}</div>
    </div>
  </div>
</section>
