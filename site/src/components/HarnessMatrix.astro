---
import { translations } from '../i18n/translations';
const t = translations.en;
---

<section
  id="matrix"
  data-testid="harness-matrix-section"
  class="space-y-6 scroll-mt-20"
>
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-obsidian-700 pb-4">
    <div>
      <div class="text-xs font-mono text-amber-accent flex items-center space-x-2">
        <span class="w-2 h-2 bg-amber-glow"></span>
        <span class="uppercase tracking-widest" data-i18n="matrix.tag">{t.matrix.tag}</span>
      </div>
      <h2 class="text-xl sm:text-3xl font-extrabold text-slate-100 uppercase font-mono mt-1 tracking-wide" data-i18n="matrix.title">{t.matrix.title}</h2>
    </div>
    <div class="flex items-center space-x-2">
      <span class="text-xs px-2.5 py-1 bg-obsidian-800 text-amber-accent border border-obsidian-700 font-mono" data-i18n="matrix.badge">{t.matrix.badge}</span>
    </div>
  </div>

  <p class="text-xs text-slate-400 font-mono max-w-3xl leading-relaxed" data-i18n="matrix.subtitle">{t.matrix.subtitle}</p>

  <!-- Tier Definitions Industrial Panel -->
  <div
    data-testid="tier-definitions"
    class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs"
  >
    <!-- Reference Tier -->
    <div class="border border-obsidian-700 bg-obsidian-950 p-4 space-y-2 border-l-2 border-l-amber-glow">
      <div class="flex items-center justify-between">
        <span class="font-bold text-amber-glow uppercase tracking-wider" data-i18n="matrix.tierRefTitle">{t.matrix.tierRefTitle}</span>
        <span class="text-[10px] px-1.5 py-0.2 bg-amber-glow/10 border border-amber-glow/40 text-amber-glow" data-i18n="matrix.tierRefBadge">{t.matrix.tierRefBadge}</span>
      </div>
      <p class="text-slate-300 text-[11px] leading-relaxed" data-i18n="matrix.tierRefDesc">{t.matrix.tierRefDesc}</p>
    </div>

    <!-- Supported Tier -->
    <div class="border border-obsidian-700 bg-obsidian-950 p-4 space-y-2 border-l-2 border-l-amber-accent">
      <div class="flex items-center justify-between">
        <span class="font-bold text-amber-accent uppercase tracking-wider" data-i18n="matrix.tierSupTitle">{t.matrix.tierSupTitle}</span>
        <span class="text-[10px] px-1.5 py-0.2 bg-amber-accent/10 border border-amber-accent/40 text-amber-accent" data-i18n="matrix.tierSupBadge">{t.matrix.tierSupBadge}</span>
      </div>
      <p class="text-slate-300 text-[11px] leading-relaxed" data-i18n="matrix.tierSupDesc">{t.matrix.tierSupDesc}</p>
    </div>

    <!-- Compatible Tier -->
    <div class="border border-obsidian-700 bg-obsidian-950 p-4 space-y-2 border-l-2 border-l-slate-400">
      <div class="flex items-center justify-between">
        <span class="font-bold text-slate-300 uppercase tracking-wider" data-i18n="matrix.tierCompTitle">{t.matrix.tierCompTitle}</span>
        <span class="text-[10px] px-1.5 py-0.2 bg-slate-800 border border-slate-700 text-slate-300" data-i18n="matrix.tierCompBadge">{t.matrix.tierCompBadge}</span>
      </div>
      <p class="text-slate-300 text-[11px] leading-relaxed" data-i18n="matrix.tierCompDesc">{t.matrix.tierCompDesc}</p>
    </div>
  </div>

  <!-- Detailed Matrix Table Container -->
  <div class="border border-obsidian-700 bg-obsidian-900/80 overflow-hidden font-mono">
    <div
      tabindex="0"
      role="region"
      aria-label="Harness compatibility matrix"
      class="overflow-x-auto focus:outline-none focus:ring-1 focus:ring-amber-glow"
    >
      <table
        data-testid="harness-matrix-table"
        class="w-full text-left text-xs border-collapse"
      >
        <thead class="bg-obsidian-950 text-slate-400 border-b border-obsidian-700 uppercase tracking-wider text-[11px]">
          <tr>
            <th class="p-3.5 border-r border-obsidian-800" data-i18n="matrix.colHarness">{t.matrix.colHarness}</th>
            <th class="p-3.5 border-r border-obsidian-800" data-i18n="matrix.colTier">{t.matrix.colTier}</th>
            <th class="p-3.5 border-r border-obsidian-800" data-i18n="matrix.colHooks">{t.matrix.colHooks}</th>
            <th class="p-3.5 border-r border-obsidian-800" data-i18n="matrix.colRoles">{t.matrix.colRoles}</th>
            <th class="p-3.5 border-r border-obsidian-800" data-i18n="matrix.colWorktrees">{t.matrix.colWorktrees}</th>
            <th class="p-3.5 border-r border-obsidian-800" data-i18n="matrix.colStructured">{t.matrix.colStructured}</th>
            <th class="p-3.5" data-i18n="matrix.colEvidence">{t.matrix.colEvidence}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-obsidian-800 text-slate-300">
          <tr class="hover:bg-obsidian-850/60 transition-colors">
            <td class="p-3.5 font-bold text-slate-100 border-r border-obsidian-800 whitespace-nowrap" data-i18n="matrix.rows.claude.name">{t.matrix.rows.claude.name}</td>
            <td class="p-3.5 border-r border-obsidian-800 whitespace-nowrap">
              <span class="px-2 py-0.5 bg-amber-glow/10 border border-amber-glow/40 text-amber-glow font-bold text-[10px]" data-i18n="matrix.rows.claude.tier">{t.matrix.rows.claude.tier}</span>
            </td>
            <td class="p-3.5 border-r border-obsidian-800 text-emerald-400" data-i18n="matrix.rows.claude.hooks">{t.matrix.rows.claude.hooks}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-300" data-i18n="matrix.rows.claude.roles">{t.matrix.rows.claude.roles}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-emerald-400" data-i18n="matrix.rows.claude.worktrees">{t.matrix.rows.claude.worktrees}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-emerald-400" data-i18n="matrix.rows.claude.structured">{t.matrix.rows.claude.structured}</td>
            <td class="p-3.5 text-slate-400 text-[11px]" data-i18n="matrix.claudeNotes">{t.matrix.claudeNotes}</td>
          </tr>
          <tr class="hover:bg-obsidian-850/60 transition-colors">
            <td class="p-3.5 font-bold text-slate-100 border-r border-obsidian-800 whitespace-nowrap" data-i18n="matrix.rows.antigravity.name">{t.matrix.rows.antigravity.name}</td>
            <td class="p-3.5 border-r border-obsidian-800 whitespace-nowrap">
              <span class="px-2 py-0.5 bg-amber-accent/10 border border-amber-accent/40 text-amber-accent font-bold text-[10px]" data-i18n="matrix.rows.antigravity.tier">{t.matrix.rows.antigravity.tier}</span>
            </td>
            <td class="p-3.5 border-r border-obsidian-800 text-emerald-400" data-i18n="matrix.rows.antigravity.hooks">{t.matrix.rows.antigravity.hooks}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-300" data-i18n="matrix.rows.antigravity.roles">{t.matrix.rows.antigravity.roles}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-emerald-400" data-i18n="matrix.rows.antigravity.worktrees">{t.matrix.rows.antigravity.worktrees}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-emerald-400" data-i18n="matrix.rows.antigravity.structured">{t.matrix.rows.antigravity.structured}</td>
            <td class="p-3.5 text-slate-400 text-[11px]" data-i18n="matrix.antigravityNotes">{t.matrix.antigravityNotes}</td>
          </tr>
          <tr class="hover:bg-obsidian-850/60 transition-colors">
            <td class="p-3.5 font-bold text-slate-100 border-r border-obsidian-800 whitespace-nowrap" data-i18n="matrix.rows.codex.name">{t.matrix.rows.codex.name}</td>
            <td class="p-3.5 border-r border-obsidian-800 whitespace-nowrap">
              <span class="px-2 py-0.5 bg-amber-accent/10 border border-amber-accent/40 text-amber-accent font-bold text-[10px]" data-i18n="matrix.rows.codex.tier">{t.matrix.rows.codex.tier}</span>
            </td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.codex.hooks">{t.matrix.rows.codex.hooks}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-300" data-i18n="matrix.rows.codex.roles">{t.matrix.rows.codex.roles}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.codex.worktrees">{t.matrix.rows.codex.worktrees}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-emerald-400" data-i18n="matrix.rows.codex.structured">{t.matrix.rows.codex.structured}</td>
            <td class="p-3.5 text-slate-400 text-[11px]" data-i18n="matrix.codexNotes">{t.matrix.codexNotes}</td>
          </tr>
          <tr class="hover:bg-obsidian-850/60 transition-colors">
            <td class="p-3.5 font-bold text-slate-100 border-r border-obsidian-800 whitespace-nowrap" data-i18n="matrix.rows.opencode.name">{t.matrix.rows.opencode.name}</td>
            <td class="p-3.5 border-r border-obsidian-800 whitespace-nowrap">
              <span class="px-2 py-0.5 bg-slate-800 border border-slate-700 text-slate-300 font-bold text-[10px]" data-i18n="matrix.rows.opencode.tier">{t.matrix.rows.opencode.tier}</span>
            </td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.opencode.hooks">{t.matrix.rows.opencode.hooks}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-300" data-i18n="matrix.rows.opencode.roles">{t.matrix.rows.opencode.roles}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.opencode.worktrees">{t.matrix.rows.opencode.worktrees}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.opencode.structured">{t.matrix.rows.opencode.structured}</td>
            <td class="p-3.5 text-slate-400 text-[11px]" data-i18n="matrix.opencodeNotes">{t.matrix.opencodeNotes}</td>
          </tr>
          <tr class="hover:bg-obsidian-850/60 transition-colors">
            <td class="p-3.5 font-bold text-slate-100 border-r border-obsidian-800 whitespace-nowrap" data-i18n="matrix.rows.cursor.name">{t.matrix.rows.cursor.name}</td>
            <td class="p-3.5 border-r border-obsidian-800 whitespace-nowrap">
              <span class="px-2 py-0.5 bg-slate-800 border border-slate-700 text-slate-300 font-bold text-[10px]" data-i18n="matrix.rows.cursor.tier">{t.matrix.rows.cursor.tier}</span>
            </td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.cursor.hooks">{t.matrix.rows.cursor.hooks}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-300" data-i18n="matrix.rows.cursor.roles">{t.matrix.rows.cursor.roles}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.cursor.worktrees">{t.matrix.rows.cursor.worktrees}</td>
            <td class="p-3.5 border-r border-obsidian-800 text-slate-400" data-i18n="matrix.rows.cursor.structured">{t.matrix.rows.cursor.structured}</td>
            <td class="p-3.5 text-slate-400 text-[11px]" data-i18n="matrix.cursorNotes">{t.matrix.cursorNotes}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Honest Disclaimer Callout -->
  <div
    data-testid="honest-disclaimer-callout"
    class="border border-obsidian-700 bg-obsidian-950 p-4 font-mono text-xs flex items-start space-x-3 text-slate-400"
  >
    <span class="text-amber-glow text-base leading-none">⚠</span>
    <div class="space-y-1">
      <div class="text-slate-200 font-bold uppercase tracking-wider" data-i18n="matrix.disclaimerTitle">{t.matrix.disclaimerTitle}</div>
      <p class="leading-relaxed" data-i18n="matrix.disclaimerBody">{t.matrix.disclaimerBody}</p>
    </div>
  </div>
</section>
