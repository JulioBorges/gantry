---
import { translations } from '../i18n/translations';
const t = translations.en;
---

<section
  id="skills"
  data-testid="skills-section"
  class="space-y-6 scroll-mt-20"
>
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-obsidian-700 pb-4">
    <div>
      <div class="text-xs font-mono text-amber-accent flex items-center space-x-2">
        <span class="w-2 h-2 bg-amber-glow"></span>
        <span class="uppercase tracking-widest" data-i18n="skills.tag">{t.skills.tag}</span>
      </div>
      <h2 class="text-xl sm:text-3xl font-extrabold text-slate-100 uppercase font-mono mt-1 tracking-wide" data-i18n="skills.title">{t.skills.title}</h2>
    </div>
    <div class="flex items-center space-x-2">
      <span class="text-xs px-2.5 py-1 bg-obsidian-800 text-amber-accent border border-obsidian-700 font-mono" data-i18n="skills.badge">{t.skills.badge}</span>
    </div>
  </div>

  <p class="text-xs text-slate-400 font-mono max-w-3xl leading-relaxed" data-i18n="skills.subtitle">{t.skills.subtitle}</p>

  <!-- Skills 4-Card Industrial Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-mono">
    <!-- Skill 3: gantry (Core Workflow) -->
    <div
      data-testid="skill-card-gantry"
      class="order-3 border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-5 hover:border-amber-glow/50 transition-all group"
    >
      <div class="space-y-4">
        <!-- Card Header -->
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-3">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 bg-amber-glow rotate-45 group-hover:scale-110 transition-transform"></span>
            <span class="text-base font-bold text-slate-100 font-mono">gantry</span>
          </div>
          <span class="text-[10px] px-2 py-0.5 bg-amber-glow/10 border border-amber-glow/40 text-amber-glow font-bold uppercase" data-i18n="skills.gantryBadge">{t.skills.gantryBadge}</span>
        </div>

        <!-- Triggers & Invocations -->
        <div class="space-y-1 text-xs">
          <span class="text-[11px] text-slate-400 uppercase tracking-wider block" data-i18n="skills.triggersLabel">{t.skills.triggersLabel}</span>
          <div class="p-2 bg-obsidian-950 border border-obsidian-800 text-amber-accent/90 text-xs break-all">
            /gantry · wave:N · implement spec &lt;slug&gt;
          </div>
        </div>

        <!-- Role & Narrative -->
        <div class="space-y-2 text-xs text-slate-300 leading-relaxed">
          <p data-i18n="skills.gantryDesc">{t.skills.gantryDesc}</p>
          <ul class="space-y-1.5 text-slate-400 pt-1 text-[11px]">
            <li class="flex items-start space-x-1.5">
              <span class="text-amber-glow">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.gantryBullet1Title">{t.skills.gantryBullet1Title}</strong> <span data-i18n="skills.gantryBullet1Desc">{t.skills.gantryBullet1Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-amber-glow">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.gantryBullet2Title">{t.skills.gantryBullet2Title}</strong> <span data-i18n="skills.gantryBullet2Desc">{t.skills.gantryBullet2Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-amber-glow">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.gantryBullet3Title">{t.skills.gantryBullet3Title}</strong> <span data-i18n="skills.gantryBullet3Desc">{t.skills.gantryBullet3Desc}</span></span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Action / Documentation Link -->
      <div class="border-t border-obsidian-800 pt-4 mt-auto">
        <a
          href="https://github.com/JulioBorges/gantry/tree/main/.agents/skills/gantry"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between w-full px-3 py-2 bg-obsidian-950 hover:bg-obsidian-850 border border-obsidian-700 hover:border-amber-glow/50 text-slate-200 text-xs transition-colors"
        >
          <span data-i18n="skills.viewSpec">{t.skills.viewSpec}</span>
          <span class="text-amber-glow">↗</span>
        </a>
      </div>
    </div>

    <!-- Skill 1: gantry-setup (Policy & Governance) -->
    <div
      data-testid="skill-card-gantry-setup"
      class="order-1 border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-5 hover:border-amber-glow/50 transition-all group"
    >
      <div class="space-y-4">
        <!-- Card Header -->
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-3">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 bg-cyan-400 rotate-45 group-hover:scale-110 transition-transform"></span>
            <span class="text-base font-bold text-slate-100 font-mono">gantry-setup</span>
          </div>
          <span class="text-[10px] px-2 py-0.5 bg-cyan-950/40 border border-cyan-700/50 text-cyan-400 font-bold uppercase" data-i18n="skills.setupBadge">{t.skills.setupBadge}</span>
        </div>

        <!-- Triggers & Invocations -->
        <div class="space-y-1 text-xs">
          <span class="text-[11px] text-slate-400 uppercase tracking-wider block" data-i18n="skills.triggersLabel">{t.skills.triggersLabel}</span>
          <div class="p-2 bg-obsidian-950 border border-obsidian-800 text-cyan-300 text-xs break-all">
            /gantry-setup · setup gantry · configure policy
          </div>
        </div>

        <!-- Role & Narrative -->
        <div class="space-y-2 text-xs text-slate-300 leading-relaxed">
          <p data-i18n="skills.setupDesc">{t.skills.setupDesc}</p>
          <ul class="space-y-1.5 text-slate-400 pt-1 text-[11px]">
            <li class="flex items-start space-x-1.5">
              <span class="text-cyan-400">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.setupBullet1Title">{t.skills.setupBullet1Title}</strong> <span data-i18n="skills.setupBullet1Desc">{t.skills.setupBullet1Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-cyan-400">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.setupBullet2Title">{t.skills.setupBullet2Title}</strong> <span data-i18n="skills.setupBullet2Desc">{t.skills.setupBullet2Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-cyan-400">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.setupBullet3Title">{t.skills.setupBullet3Title}</strong> <span data-i18n="skills.setupBullet3Desc">{t.skills.setupBullet3Desc}</span></span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Action / Documentation Link -->
      <div class="border-t border-obsidian-800 pt-4 mt-auto">
        <a
          href="https://github.com/JulioBorges/gantry/tree/main/.agents/skills/gantry-setup"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between w-full px-3 py-2 bg-obsidian-950 hover:bg-obsidian-850 border border-obsidian-700 hover:border-cyan-400/50 text-slate-200 text-xs transition-colors"
        >
          <span data-i18n="skills.viewSpec">{t.skills.viewSpec}</span>
          <span class="text-cyan-400">↗</span>
        </a>
      </div>
    </div>

    <!-- Skill 2: gantry-plan (Standalone Planning) -->
    <div
      data-testid="skill-card-gantry-plan"
      class="order-2 border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-5 hover:border-amber-glow/50 transition-all group"
    >
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-3">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 bg-emerald-400 rotate-45 group-hover:scale-110 transition-transform"></span>
            <span class="text-base font-bold text-slate-100 font-mono">gantry-plan</span>
          </div>
          <span class="text-[10px] px-2 py-0.5 bg-emerald-950/40 border border-emerald-700/50 text-emerald-400 font-bold uppercase" data-i18n="skills.planBadge">{t.skills.planBadge}</span>
        </div>

        <div class="space-y-1 text-xs">
          <span class="text-[11px] text-slate-400 uppercase tracking-wider block" data-i18n="skills.triggersLabel">{t.skills.triggersLabel}</span>
          <div class="p-2 bg-obsidian-950 border border-obsidian-800 text-emerald-300 text-xs break-all">
            /gantry-plan &lt;goal | spec-slug | spec-path&gt;
          </div>
        </div>

        <div class="space-y-2 text-xs text-slate-300 leading-relaxed">
          <p data-i18n="skills.planDesc">{t.skills.planDesc}</p>
          <ul class="space-y-1.5 text-slate-400 pt-1 text-[11px]">
            <li class="flex items-start space-x-1.5">
              <span class="text-emerald-400">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.planBullet1Title">{t.skills.planBullet1Title}</strong> <span data-i18n="skills.planBullet1Desc">{t.skills.planBullet1Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-emerald-400">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.planBullet2Title">{t.skills.planBullet2Title}</strong> <span data-i18n="skills.planBullet2Desc">{t.skills.planBullet2Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-emerald-400">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.planBullet3Title">{t.skills.planBullet3Title}</strong> <span data-i18n="skills.planBullet3Desc">{t.skills.planBullet3Desc}</span></span>
            </li>
          </ul>
        </div>
      </div>

      <div class="border-t border-obsidian-800 pt-4 mt-auto">
        <a
          href="https://github.com/JulioBorges/gantry/tree/main/.agents/skills/gantry-plan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between w-full px-3 py-2 bg-obsidian-950 hover:bg-obsidian-850 border border-obsidian-700 hover:border-emerald-400/50 text-slate-200 text-xs transition-colors"
        >
          <span data-i18n="skills.viewSpec">{t.skills.viewSpec}</span>
          <span class="text-emerald-400">↗</span>
        </a>
      </div>
    </div>

    <!-- Skill 4: gantry-dashboard (Local Observability) -->
    <div
      data-testid="skill-card-gantry-dashboard"
      class="order-4 border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-5 hover:border-amber-glow/50 transition-all group"
    >
      <div class="space-y-4">
        <!-- Card Header -->
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-3">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 bg-amber-accent rotate-45 group-hover:scale-110 transition-transform"></span>
            <span class="text-base font-bold text-slate-100 font-mono">gantry-dashboard</span>
          </div>
          <span class="text-[10px] px-2 py-0.5 bg-amber-950/40 border border-amber-800/50 text-amber-accent font-bold uppercase" data-i18n="skills.dashboardBadge">{t.skills.dashboardBadge}</span>
        </div>

        <!-- Triggers & Invocations -->
        <div class="space-y-1 text-xs">
          <span class="text-[11px] text-slate-400 uppercase tracking-wider block" data-i18n="skills.triggersLabel">{t.skills.triggersLabel}</span>
          <div class="p-2 bg-obsidian-950 border border-obsidian-800 text-amber-accent text-xs break-all">
            /gantry-dashboard · open dashboard · show runs
          </div>
        </div>

        <!-- Role & Narrative -->
        <div class="space-y-2 text-xs text-slate-300 leading-relaxed">
          <p data-i18n="skills.dashboardDesc">{t.skills.dashboardDesc}</p>
          <ul class="space-y-1.5 text-slate-400 pt-1 text-[11px]">
            <li class="flex items-start space-x-1.5">
              <span class="text-amber-accent">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.dashboardBullet1Title">{t.skills.dashboardBullet1Title}</strong> <span data-i18n="skills.dashboardBullet1Desc">{t.skills.dashboardBullet1Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-amber-accent">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.dashboardBullet2Title">{t.skills.dashboardBullet2Title}</strong> <span data-i18n="skills.dashboardBullet2Desc">{t.skills.dashboardBullet2Desc}</span></span>
            </li>
            <li class="flex items-start space-x-1.5">
              <span class="text-amber-accent">›</span>
              <span><strong class="text-slate-200" data-i18n="skills.dashboardBullet3Title">{t.skills.dashboardBullet3Title}</strong> <span data-i18n="skills.dashboardBullet3Desc">{t.skills.dashboardBullet3Desc}</span></span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Action / Documentation Link -->
      <div class="border-t border-obsidian-800 pt-4 mt-auto">
        <a
          href="https://github.com/JulioBorges/gantry/tree/main/.agents/skills/gantry-dashboard"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between w-full px-3 py-2 bg-obsidian-950 hover:bg-obsidian-850 border border-obsidian-700 hover:border-amber-glow/50 text-slate-200 text-xs transition-colors"
        >
          <span data-i18n="skills.viewSpec">{t.skills.viewSpec}</span>
          <span class="text-amber-glow">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
