---
import { translations } from '../i18n/translations';
const t = translations.en;
---

<section
  id="problem-solution"
  data-testid="problem-solution-section"
  class="space-y-6 scroll-mt-20"
>
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-obsidian-700 pb-4">
    <div>
      <div class="text-xs font-mono text-amber-accent flex items-center space-x-2">
        <span class="w-2 h-2 bg-amber-glow"></span>
        <span class="uppercase tracking-widest" data-i18n="problemSolution.tag">{t.problemSolution.tag}</span>
      </div>
      <h2 class="text-xl sm:text-3xl font-extrabold text-slate-100 uppercase font-mono mt-1 tracking-wide" data-i18n="problemSolution.title">{t.problemSolution.title}</h2>
    </div>
    <p class="text-xs text-slate-400 font-mono max-w-lg" data-i18n="problemSolution.subtitle">{t.problemSolution.subtitle}</p>
  </div>

  <!-- Core Thesis Industrial Banner -->
  <div
    data-testid="core-thesis-banner"
    class="border-l-4 border-l-amber-glow border border-obsidian-700 bg-obsidian-950 p-4 sm:p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 font-mono"
  >
    <div class="space-y-1">
      <div class="flex items-center space-x-2 text-amber-glow text-xs font-bold uppercase tracking-wider">
        <span>◆</span>
        <span data-i18n="problemSolution.thesisTag">{t.problemSolution.thesisTag}</span>
      </div>
      <p class="text-sm sm:text-base text-slate-100 font-bold" data-i18n="problemSolution.thesisQuote">{t.problemSolution.thesisQuote}</p>
      <p class="text-xs text-slate-400 leading-relaxed max-w-3xl" data-i18n="problemSolution.thesisDesc">{t.problemSolution.thesisDesc}</p>
    </div>
    <div class="flex-shrink-0 flex items-center space-x-2 px-3 py-1.5 bg-obsidian-850 border border-obsidian-700 text-xs text-slate-300">
      <span class="text-amber-glow font-bold" data-i18n="problemSolution.thesisAuthorityLabel">{t.problemSolution.thesisAuthorityLabel}</span>
      <span class="text-slate-200" data-i18n="problemSolution.thesisAuthorityVal">{t.problemSolution.thesisAuthorityVal}</span>
    </div>
  </div>

  <!-- Structured Comparison Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-mono">
    <!-- Card 1: Context Degradation & Bloat -->
    <div
      data-testid="problem-card-context"
      class="border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-4 hover:border-obsidian-600 transition-colors relative overflow-hidden group"
    >
      <div class="space-y-3">
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-2.5">
          <span class="text-xs font-bold text-red-400 bg-red-950/50 border border-red-800/60 px-2 py-0.5" data-i18n="problemSolution.pitfall1Tag">{t.problemSolution.pitfall1Tag}</span>
          <span class="text-[10px] text-slate-400 uppercase" data-i18n="problemSolution.pitfall1Category">{t.problemSolution.pitfall1Category}</span>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-100 uppercase tracking-wide" data-i18n="problemSolution.pitfall1Title">{t.problemSolution.pitfall1Title}</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed" data-i18n="problemSolution.pitfall1Desc">{t.problemSolution.pitfall1Desc}</p>
        </div>
      </div>

      <!-- Gantry Guardrail Resolution -->
      <div class="border-t border-obsidian-800 pt-3 bg-obsidian-950/70 -mx-5 sm:-mx-6 -mb-5 sm:-mb-6 p-4 border-l-2 border-l-emerald-500">
        <div class="text-emerald-400 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 mb-1">
          <span>✓</span>
          <span data-i18n="problemSolution.gantry1Title">{t.problemSolution.gantry1Title}</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed" data-i18n="problemSolution.gantry1Desc">{t.problemSolution.gantry1Desc}</p>
      </div>
    </div>

    <!-- Card 2: Mock Escapes & Test Tampering -->
    <div
      data-testid="problem-card-mocks"
      class="border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-4 hover:border-obsidian-600 transition-colors relative overflow-hidden group"
    >
      <div class="space-y-3">
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-2.5">
          <span class="text-xs font-bold text-red-400 bg-red-950/50 border border-red-800/60 px-2 py-0.5" data-i18n="problemSolution.pitfall2Tag">{t.problemSolution.pitfall2Tag}</span>
          <span class="text-[10px] text-slate-400 uppercase" data-i18n="problemSolution.pitfall2Category">{t.problemSolution.pitfall2Category}</span>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-100 uppercase tracking-wide" data-i18n="problemSolution.pitfall2Title">{t.problemSolution.pitfall2Title}</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed" data-i18n="problemSolution.pitfall2Desc">{t.problemSolution.pitfall2Desc}</p>
        </div>
      </div>

      <!-- Gantry Guardrail Resolution -->
      <div class="border-t border-obsidian-800 pt-3 bg-obsidian-950/70 -mx-5 sm:-mx-6 -mb-5 sm:-mb-6 p-4 border-l-2 border-l-emerald-500">
        <div class="text-emerald-400 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 mb-1">
          <span>✓</span>
          <span data-i18n="problemSolution.gantry2Title">{t.problemSolution.gantry2Title}</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed" data-i18n="problemSolution.gantry2Desc">{t.problemSolution.gantry2Desc}</p>
      </div>
    </div>

    <!-- Card 3: Unearned Self-Approval -->
    <div
      data-testid="problem-card-approval"
      class="border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-4 hover:border-obsidian-600 transition-colors relative overflow-hidden group"
    >
      <div class="space-y-3">
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-2.5">
          <span class="text-xs font-bold text-red-400 bg-red-950/50 border border-red-800/60 px-2 py-0.5" data-i18n="problemSolution.pitfall3Tag">{t.problemSolution.pitfall3Tag}</span>
          <span class="text-[10px] text-slate-400 uppercase" data-i18n="problemSolution.pitfall3Category">{t.problemSolution.pitfall3Category}</span>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-100 uppercase tracking-wide" data-i18n="problemSolution.pitfall3Title">{t.problemSolution.pitfall3Title}</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed" data-i18n="problemSolution.pitfall3Desc">{t.problemSolution.pitfall3Desc}</p>
        </div>
      </div>

      <!-- Gantry Guardrail Resolution -->
      <div class="border-t border-obsidian-800 pt-3 bg-obsidian-950/70 -mx-5 sm:-mx-6 -mb-5 sm:-mb-6 p-4 border-l-2 border-l-emerald-500">
        <div class="text-emerald-400 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 mb-1">
          <span>✓</span>
          <span data-i18n="problemSolution.gantry3Title">{t.problemSolution.gantry3Title}</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed" data-i18n="problemSolution.gantry3Desc">{t.problemSolution.gantry3Desc}</p>
      </div>
    </div>

    <!-- Card 4: Flaky Merges & Branch Drifts -->
    <div
      data-testid="problem-card-drift"
      class="border border-obsidian-700 bg-obsidian-900/90 p-5 sm:p-6 flex flex-col justify-between space-y-4 hover:border-obsidian-600 transition-colors relative overflow-hidden group"
    >
      <div class="space-y-3">
        <div class="flex items-center justify-between border-b border-obsidian-800 pb-2.5">
          <span class="text-xs font-bold text-red-400 bg-red-950/50 border border-red-800/60 px-2 py-0.5" data-i18n="problemSolution.pitfall4Tag">{t.problemSolution.pitfall4Tag}</span>
          <span class="text-[10px] text-slate-400 uppercase" data-i18n="problemSolution.pitfall4Category">{t.problemSolution.pitfall4Category}</span>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-100 uppercase tracking-wide" data-i18n="problemSolution.pitfall4Title">{t.problemSolution.pitfall4Title}</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed" data-i18n="problemSolution.pitfall4Desc">{t.problemSolution.pitfall4Desc}</p>
        </div>
      </div>

      <!-- Gantry Guardrail Resolution -->
      <div class="border-t border-obsidian-800 pt-3 bg-obsidian-950/70 -mx-5 sm:-mx-6 -mb-5 sm:-mb-6 p-4 border-l-2 border-l-emerald-500">
        <div class="text-emerald-400 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 mb-1">
          <span>✓</span>
          <span data-i18n="problemSolution.gantry4Title">{t.problemSolution.gantry4Title}</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed" data-i18n="problemSolution.gantry4Desc">{t.problemSolution.gantry4Desc}</p>
      </div>
    </div>
  </div>
</section>
